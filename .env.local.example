# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# PayPal (Sandbox for dev)
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_secret
PAYPAL_MODE=sandbox
# Optional: enables PayPal webhook signature verification (PayPal dashboard -> app -> Webhooks)
PAYPAL_WEBHOOK_ID=

# Square (Sandbox for dev)
SQUARE_ACCESS_TOKEN=your_sandbox_access_token
SQUARE_LOCATION_ID=your_sandbox_location_id
SQUARE_MODE=sandbox
# Optional: enables Square webhook HMAC verification (Square dashboard -> Webhooks -> Signature key)
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Square Web Payments SDK — public application id for the embedded card form
# (different from the access token; from Square dashboard -> Applications)
SQUARE_APP_ID=

# Resend (transactional email + mailing-list broadcasts)
RESEND_API_KEY=

# Optional: canonical origin used for payment return URLs, password-reset
# redirects and email links (defaults to the requesting host in dev; production
# sets this to https://lovingcharmz.com on Vercel)
NEXT_PUBLIC_SITE_URL=

# Canada Post Developer Portal (developer-developpeur.canadapost-postescanada.ca)
# One key:secret pair per portal app subscription. Families authorize
# independently - Rating, Shipping, Tracking are separate API products.
# Also required: CP_CUSTOMER_NUMBER (10-digit mailed-by number), CP_ORIGIN_POSTAL,
# CP_SENDER_ADDRESS / CP_SENDER_CITY / CP_SENDER_PROVINCE / CP_SENDER_PHONE.
CP_RATING_KEY=
CP_SHIPPING_KEY=
CP_TRACKING_KEY=
