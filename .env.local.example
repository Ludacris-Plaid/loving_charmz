# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# PayPal (Sandbox for dev)
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_secret
PAYPAL_MODE=sandbox
# Optional: enables PayPal webhook signature verification (PayPal dashboard -> app -> Webhooks)
PAYPAL_WEBHOOK_ID=

# Square (Sandbox for dev)
SQUARE_ACCESS_TOKEN=your_sandbox_access_token
SQUARE_LOCATION_ID=your_sandbox_location_id
SQUARE_MODE=sandbox
# Optional: enables Square webhook HMAC verification (Square dashboard -> Webhooks -> Signature key)
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Mailchimp
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER_PREFIX=

# Optional: canonical origin used for payment return URLs (defaults to the requesting host)
NEXT_PUBLIC_SITE_URL=
