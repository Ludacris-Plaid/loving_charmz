# Loving Charmz — Supabase project migration credentials.
# Copy to .env.migrate (gitignored) and fill in. Never commit real values.
#
#   cp scripts/migrate/.env.migrate.example scripts/migrate/.env.migrate
#
# Database URLs: Dashboard -> Project Settings -> Database -> Connection string.
# Use the direct connection or the SESSION pooler (port 5432). pg_dump and
# migrations cannot run through the transaction pooler (port 6543).
# Percent-encode the password if it contains @ : / ? # or &.

# --- old project: otareqhvjbcbiehmgzda ---------------------------------------
OLD_DB_URL=postgresql://postgres.otareqhvjbcbiehmgzda:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
OLD_SUPABASE_URL=https://otareqhvjbcbiehmgzda.supabase.co
# Project Settings -> API -> service_role (server-side only, never in the browser)
OLD_SERVICE_ROLE_KEY=

# --- new project: ivvsglfjlmejwmwofvuw ---------------------------------------
NEW_DB_URL=postgresql://postgres.ivvsglfjlmejwmwofvuw:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
NEW_SUPABASE_URL=https://ivvsglfjlmejwmwofvuw.supabase.co
NEW_SERVICE_ROLE_KEY=

# Optional: override the refs used for URL rewriting (defaults are the two above)
# OLD_REF=otareqhvjbcbiehmgzda
# NEW_REF=ivvsglfjlmejwmwofvuw
